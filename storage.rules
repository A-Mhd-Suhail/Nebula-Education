rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Board images are public-read so their URLs NEVER expire (no 404s).
    // Retention is handled by a Firestore TTL on boardImages (see README: 90 days).
    match /boardImages/{room}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if false;
    }
  }
}
