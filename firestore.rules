rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isHm() { return signedIn() && myRole() in ['hm', 'meo', 'deo', 'admin']; }
    function isTeacher() { return signedIn() && myRole() in ['teacher','hm','meo','deo','admin']; }

    match /settings/{d} { allow read: if signedIn(); allow write: if isHm(); }
    match /auditLogs/{d} { allow read: if isHm(); allow create: if signedIn(); allow update, delete: if false; }

    // USERS: scores are written ONLY by Cloud Functions (which bypass rules).
    // Browser users can never fake role / airScore / behaviorScore.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['student','teacher','hm','meo','deo','admin'];
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.airScore == resource.data.airScore
        && request.resource.data.behaviorScore == resource.data.behaviorScore;
      allow update: if isHm();
      allow delete: if false;
    }

    match /sessions/{d}    { allow read, create, update: if signedIn(); allow delete: if false; }
    match /attendance/{d}  { allow read, create, update: if signedIn(); allow delete: if false; }
    match /contents/{d}    { allow read, create: if signedIn(); allow update, delete: if false; }
    match /assignments/{d} { allow read, create, update: if signedIn(); allow delete: if false; }
    match /submissions/{d} { allow read, create, update: if signedIn(); allow delete: if false; }
    match /marks/{d}       { allow read, create: if signedIn(); allow update, delete: if false; }

    match /doubts/{d} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if false;
    }

    match /feed/{d} {
      allow read, create: if signedIn();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isHm());
    }

    match /projects/{d} { allow read, create, update: if signedIn(); allow delete: if false; }

    // RATINGS: doc-id is "${sessionId}_${studentUid}" set by the client, so a
    // second rating by the same student for the same session OVERWRITES, never spams.
    match /ratings/{rid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.studentUid == request.auth.uid;
      allow delete: if false;
    }

    match /syllabus/{d}     { allow read, create, update: if signedIn(); allow delete: if false; }
    match /quizzes/{d}      { allow read, create: if signedIn(); allow update, delete: if false; }
    match /quizRequests/{d} { allow read, create, update: if signedIn(); allow delete: if false; }
    match /incidents/{d}    { allow read, create, update: if signedIn(); allow delete: if false; }
    match /noiseEvents/{d}  { allow read, create: if signedIn(); allow update, delete: if false; }
    match /devices/{d}      { allow read: if signedIn(); allow write: if isHm(); }
    match /hardware/{d}     { allow read, create, update: if signedIn(); allow delete: if isHm(); }
    match /boardImages/{d}  { allow read, create: if signedIn(); allow update, delete: if false; }
    match /classroomEvents/{d} { allow read, create: if signedIn(); allow update, delete: if false; }
    match /alerts/{d}       { allow read, create, update: if signedIn(); allow delete: if false; }
    match /airHistory/{d}   { allow read: if signedIn(); allow create, update, delete: if false; }
    match /presence/{d}     { allow read, create, update: if signedIn(); allow delete: if false; }
    match /speechLogs/{d}   { allow read, create: if signedIn(); allow update, delete: if false; }
    match /timetable/{d}    { allow read: if signedIn(); allow write: if isTeacher(); }

    match /notifications/{d} {
      allow read:   if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
